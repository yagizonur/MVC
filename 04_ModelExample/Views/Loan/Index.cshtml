@model LoanCalculationModel

@{
    Layout = "_Layout";
}

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">

    <!-- GİRİŞ FORMU -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
        <h2 class="text-lg font-bold text-gray-800 mb-4 border-b pb-2">Kredi Giriş Bilgileri</h2>

        <form asp-controller="Loan" asp-action="Calculate" method="post" class="space-y-4">
            <div>
                <label asp-for="Amount" class="block text-sm font-medium text-gray-700 mb-1">Kredi Tutarı (TL)</label>
                <input asp-for="Amount" type="number" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="Örn: 50000" />
                <!-- Model'deki hata mesajını otomatik kırmızı basar -->
                <span asp-validation-for="Amount" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="MonthTerm" class="block text-sm font-medium text-gray-700 mb-1">Vade (Ay)</label>
                <select asp-for="MonthTerm" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                    <option value="">Vade Seçiniz</option>
                    <option value="3">3 Ay</option>
                    <option value="6">6 Ay</option>
                    <option value="12">12 Ay</option>
                    <option value="24">24 Ay</option>
                    <option value="36">36 Ay</option>

                </select>
                <span asp-validation-for="MonthTerm" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-2 rounded-lg font-semibold transition cursor-pointer">
                Hesapla
            </button>
        </form>

        <!-- SONUÇ EKRANI -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200 flex flex-col justify-center">
            @if (Model.IsCalculated)
            {
                <h2 class="text-lg font-bold text-gray-800 mb-4 border-b pb-2 text-emerald-600">Ödeme Planı Özeti</h2>
                <div class="space-y-3">
                    <div class="flex justify-between border-b pb-2 text-sm text-gray-600">
                        <span>Talep Edilen Kredi:</span>
                        <span class="font-bold text-gray-900">@Model.Amount.ToString("N2") TL</span>
                    </div>
                    <div class="flex justify-between border-b pb-2 text-sm text-gray-600">
                        <span>Aylık Faiz Oranı:</span>
                        <span class="font-bold text-gray-900">%@(Model.InterestRate * 100)</span>
                    </div>
                    <div class="flex justify-between border-b pb-2 text-sm text-gray-600">
                        <span>Vade:</span>
                        <span class="font-bold text-gray-900">@Model.MonthTerm Ay</span>
                    </div>
                    <div class="flex justify-between border-b pb-2 text-base font-semibold text-gray-800">
                        <span>Taksit Tutarı:</span>
                        <span class="text-indigo-600">@Model.MonthlyPayment.ToString("N2") TL</span>
                    </div>
                    <div class="bg-indigo-50 p-3 rounded-xl flex justify-between items-center text-sm font-bold text-indigo-900">
                        <span>Toplam Geri Ödeme:</span>
                        <span class="text-base">@Model.TotalRepayable.ToString("N2") TL</span>
                    </div>
                </div>
            }

            else
            {
                <div class="text-center text-gray-400 py-8">
                    <p class="text-sm">Hesaplama sonuçları burada görünecektir.</p>
                    <p class="text-xs mt-1">Lütfen soldaki formu doldurup "Hesapla" butonuna basın.</p>
                </div>
            }
        </div>

</div>