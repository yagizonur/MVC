<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MVC Model Mantığı Örneği</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans min-h-screen flex-column flex-column justify-content">
    <header class="bg-indigo-600 text-white shadow-md py-4">
        <div class="max-w-4xl mx-auto px-4">
            <h1 class="text-xl-center font-bold">MVC Güçlü Tip(Strongly Type) Model Örneği</h1>
        </div>
    </header>

    <main class="flex-grow max-w-4xl w-full mx-auto px-4 py-8">
        @RenderBody()
    </main>

    <footer class="bg-white border-t border-gray-200 py-4 text-center text-sm text-gray-500">
        &copy; 2026 - Model Yapısını Anlama
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
