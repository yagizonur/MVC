@model _05_Model_Binding.ViewModels.HomePageViewModel
@{
    ViewData["Title"] = "ViewModel ile Çoklu Model Binding";
}

<!--
====================================================================
KONU: VIEWMODEL PATTERN & COMPLEX MODEL BINDING
====================================================================
1. Neden ViewModel?
   - ASP.NET Core Razor View'leri sadece TEK bir model tipi (@@model) alabilir.
   - İki veya daha fazla nesneyi (örneğin Kisi ve Adres) View'e aktarmak ve formdan geri
     almak için bir kapsayıcı (wrapper) ViewModel sınıfı tanımlanır.

2. İç İçe Model Binding (Nested Binding):
   - Tag Helper: <input asp-for="KisiNesnesi.Ad" />
   - HTML çıktısı: <input name="KisiNesnesi.Ad" ... />
   - Model Binder nokta (.) operatörünü ayrıştırarak nesne hiyerarşisini otomatik oluşturur.
====================================================================
-->

<div class="space-y-6 max-w-4xl mx-auto">

    <!-- Başlık -->
    <div class="border-b border-slate-800 pb-4">
        <span class="inline-block px-2.5 py-1 text-xs font-semibold bg-emerald-500/20 text-emerald-300 rounded-full mb-2">
            ViewModel Deseni
        </span>
        <h1 class="text-3xl font-extrabold text-white">Çoklu Nesnelerin ViewModel ile Yönetimi</h1>
        <p class="text-slate-400 text-sm mt-1">Tek bir form üzerinden birden çok model sınıfının iç içe (nested) bind edilmesi</p>
    </div>

    @if (ViewBag.IsPostBack == true)
    {
        <div class="bg-emerald-950/40 border border-emerald-500/50 rounded-2xl p-6 shadow-xl space-y-3">
            <div class="flex items-center gap-2 text-emerald-400 font-bold text-sm">
                <span>✅</span>
                <span>@ViewBag.Message</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono text-slate-300">
                <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 space-y-1">
                    <span class="text-indigo-400 font-bold">Kişi Verisi:</span>
                    <p>Ad: @Model?.KisiNesnesi?.Ad</p>
                    <p>Soyad: @Model?.KisiNesnesi?.Soyad</p>
                    <p>Yaş: @Model?.KisiNesnesi?.Yas</p>
                </div>
                <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 space-y-1">
                    <span class="text-sky-400 font-bold">Adres Verisi:</span>
                    <p>Tanım: @Model?.AdresNesnesi?.AdresTanim</p>
                    <p>Şehir: @Model?.AdresNesnesi?.Sehir</p>
                </div>
            </div>
        </div>
    }

    <!-- Form Kartı -->
    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 shadow-xl">
        <form asp-action="HomePage2" method="post" class="space-y-6">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Sol Sütun: Kişi Bilgileri -->
                <div class="space-y-4 bg-slate-900/50 p-4 rounded-xl border border-slate-700/60">
                    <h3 class="text-sm font-bold text-indigo-400 uppercase tracking-wider flex items-center gap-2">
                        <span>👤</span>
                        <span>Kişi Bilgileri (KisiNesnesi)</span>
                    </h3>

                    <div>
                        <label asp-for="KisiNesnesi.Ad" class="block text-xs font-semibold text-slate-300 mb-1">Ad</label>
                        <input asp-for="KisiNesnesi.Ad" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none transition" />
                    </div>

                    <div>
                        <label asp-for="KisiNesnesi.Soyad" class="block text-xs font-semibold text-slate-300 mb-1">Soyad</label>
                        <input asp-for="KisiNesnesi.Soyad" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none transition" />
                    </div>

                    <div>
                        <label asp-for="KisiNesnesi.Yas" class="block text-xs font-semibold text-slate-300 mb-1">Yaş</label>
                        <input asp-for="KisiNesnesi.Yas" type="number" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none transition" />
                    </div>
                </div>

                <!-- Sağ Sütun: Adres Bilgileri -->
                <div class="space-y-4 bg-slate-900/50 p-4 rounded-xl border border-slate-700/60">
                    <h3 class="text-sm font-bold text-sky-400 uppercase tracking-wider flex items-center gap-2">
                        <span>🏠</span>
                        <span>Adres Bilgileri (AdresNesnesi)</span>
                    </h3>

                    <div>
                        <label asp-for="AdresNesnesi.AdresTanim" class="block text-xs font-semibold text-slate-300 mb-1">Adres Tanımı</label>
                        <input asp-for="AdresNesnesi.AdresTanim" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-sky-500 focus:outline-none transition" />
                    </div>

                    <div>
                        <label asp-for="AdresNesnesi.Sehir" class="block text-xs font-semibold text-slate-300 mb-1">Şehir</label>
                        <input asp-for="AdresNesnesi.Sehir" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-sky-500 focus:outline-none transition" />
                    </div>

                    <div class="p-3 bg-slate-900/90 rounded-lg text-xs text-slate-400 border border-slate-800">
                        <span class="text-amber-400 font-semibold">İpucu:</span> HTML'de bu inputların isimleri <code>name="AdresNesnesi.Sehir"</code> olarak oluşturulur.
                    </div>
                </div>
            </div>

            <button type="submit" class="w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-xl text-sm transition shadow-lg shadow-emerald-600/30">
                ViewModel'i Gönder ve İki Modeli Birden Bind Et 📦
            </button>
        </form>
    </div>

</div>
