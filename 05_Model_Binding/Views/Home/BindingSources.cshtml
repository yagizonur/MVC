@{
    ViewData["Title"] = "Model Binding Veri Kaynakları";
}

<!--
====================================================================
KONU: MODEL BINDING VERİ KAYNAKLARI (ATTRIBUTES)
====================================================================
1. [FromRoute]: URL rota desenindeki parametreden okur. (Örn: /Home/BindingSources/42)
2. [FromQuery]: URL QueryString alanından okur. (Örn: ?q=aspnetcore)
3. [FromHeader]: HTTP Request Headers (Başlıklar) alanından okur. (Örn: User-Agent)
4. [FromForm]: POST gövdesindeki form verisinden okur.
5. [FromBody]: JSON veya XML gövdesinden okur (Özellikle REST API ve AJAX isteklerinde).
====================================================================
-->

<div class="space-y-6 max-w-4xl mx-auto">

    <div class="border-b border-slate-800 pb-4">
        <span class="inline-block px-2.5 py-1 text-xs font-semibold bg-sky-500/20 text-sky-300 rounded-full mb-2">
            Gelişmiş Model Binding
        </span>
        <h1 class="text-3xl font-extrabold text-white">HTTP Veri Kaynakları & Öznitelikleri</h1>
        <p class="text-slate-400 text-sm mt-1">[FromRoute], [FromQuery] ve [FromHeader] ile farklı katmanlardan veri bağlama</p>
    </div>

    <!-- Canlı Değerler Paneli -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

        <!-- [FromRoute] Kartı -->
        <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 shadow-lg space-y-2">
            <span class="text-xs font-bold text-amber-400 uppercase tracking-wider">[FromRoute] id</span>
            <div class="p-3 bg-slate-900 rounded-xl font-mono text-emerald-400 text-lg font-bold">
                @ViewBag.RouteId
            </div>
            <p class="text-xs text-slate-400">URL yolundaki rota şablonundan ({id}) alındı.</p>
        </div>

        <!-- [FromQuery] Kartı -->
        <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 shadow-lg space-y-2">
            <span class="text-xs font-bold text-sky-400 uppercase tracking-wider">[FromQuery] q</span>
            <div class="p-3 bg-slate-900 rounded-xl font-mono text-sky-400 text-sm font-semibold truncate">
                @ViewBag.SearchQuery
            </div>
            <p class="text-xs text-slate-400">URL'nin sonundaki <code>?q=...</code> parametresinden alındı.</p>
        </div>

        <!-- [FromHeader] Kartı -->
        <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 shadow-lg space-y-2">
            <span class="text-xs font-bold text-purple-400 uppercase tracking-wider">[FromHeader] User-Agent</span>
            <div class="p-3 bg-slate-900 rounded-xl font-mono text-purple-300 text-xs truncate">
                @ViewBag.UserAgent
            </div>
            <p class="text-xs text-slate-400">Tarayıcının gönderdiği HTTP başlığından alındı.</p>
        </div>

    </div>

    <!-- Hızlı Test Butonları -->
    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 shadow-xl space-y-4">
        <h3 class="text-base font-bold text-white">Farklı Parametrelerle Canlı Test Edin:</h3>
        <div class="flex flex-wrap gap-3">
            <a asp-action="BindingSources" asp-route-id="100" asp-route-q="csharp-ogreniyorum" class="px-3.5 py-2 bg-slate-700 hover:bg-slate-600 rounded-xl text-xs font-mono text-white transition">
                /BindingSources/100?q=csharp-ogreniyorum
            </a>
            <a asp-action="BindingSources" asp-route-id="555" asp-route-q="aspnet-mvc-model-binding" class="px-3.5 py-2 bg-slate-700 hover:bg-slate-600 rounded-xl text-xs font-mono text-white transition">
                /BindingSources/555?q=aspnet-mvc-model-binding
            </a>
            <a asp-action="BindingSources" asp-route-id="1" asp-route-q="tailwind" class="px-3.5 py-2 bg-slate-700 hover:bg-slate-600 rounded-xl text-xs font-mono text-white transition">
                /BindingSources/1?q=tailwind
            </a>
        </div>
    </div>

</div>
