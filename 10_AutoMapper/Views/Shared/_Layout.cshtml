<!DOCTYPE html>
<html lang="tr" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoMapper Mimarisi</title>
    <!-- Tailwind CSS 3.x CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-slate-900 text-slate-100 min-h-full flex flex-col font-sans antialiased">

    <header class="bg-slate-800/90 backdrop-blur border-b border-slate-700/80 sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <a asp-controller="User" asp-action="Index" class="text-indigo-400 font-bold text-lg flex items-center gap-2">
                <span>🔄</span>
                <span>11_AutoMapper</span>
            </a>
            <nav class="flex items-center gap-2 md:gap-3 text-xs md:text-sm font-medium">
                <a asp-controller="User" asp-action="Index" class="text-slate-300 hover:text-white transition px-3 py-1.5 rounded-lg hover:bg-slate-700/50">1. Entity ➔ DTO</a>
                <a asp-controller="User" asp-action="MappingTest" class="text-slate-300 hover:text-white transition px-3 py-1.5 rounded-lg hover:bg-slate-700/50">2. DTO ➔ Entity (ReverseMap)</a>
                <a asp-controller="Integration" asp-action="Index" class="text-emerald-400 hover:text-emerald-300 transition px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/30 hover:bg-emerald-500/20 flex items-center gap-1.5">
                    <span>⚡</span> 3. Dış API Entegrasyonu (Gerçek Hayat)
                </a>
            </nav>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-8">
        @RenderBody()
    </main>

    <footer class="bg-slate-950 border-t border-slate-800 py-6 text-center text-xs text-slate-500">
        &copy; @DateTime.Now.Year - ASP.NET Core MVC AutoMapper & DTO Mimarisi
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
