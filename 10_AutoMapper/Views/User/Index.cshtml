@using _10_AutoMapper.Dtos

@model UserDto
@{
    ViewData["Title"] = "AutoMapper: Entity ➔ DTO Dönüşümü";
    var sourceUser = ViewBag.SourceUser as _10_AutoMapper.Models.User;
}

<!--
====================================================================
KONU: AUTOMAPPER & DTO (DATA TRANSFER OBJECT) MİMARİSİ
====================================================================
1. Neden DTO Kullanılır?
   - Entity doğrudan arayüze verilirse PasswordHash gibi gizli alanlar
     istemciye taşınır ve güvenlik açığı oluşur.
   - DTO sadece gerekli alanları barındırır.

2. AutoMapper'ın Rolü:
   - Kaynak sınıftaki FirstName ve LastName alanlarını tek bir satırda
     FullName özelliğine birleştirerek eşler.
====================================================================
-->

<div class="space-y-6 max-w-5xl mx-auto">

    <!-- Başlık -->
    <div class="border-b border-slate-800 pb-4">
        <span class="inline-block px-2.5 py-1 text-xs font-semibold bg-indigo-500/20 text-indigo-300 rounded-full mb-2">
            Modül 16: AutoMapper
        </span>
        <h1 class="text-3xl font-extrabold text-white">Entity ➔ DTO Otomatik Eşleme</h1>
        <p class="text-slate-400 text-sm mt-1">Veritabanı varlığının hassas verilerden arındırılarak DTO modeline dönüştürülmesi</p>
    </div>

    <!-- Yan Yana Karşılaştırma Paneli -->
    <div class="grid grid-cols-1 lg:grid-cols-11 gap-4 items-center">
        
        <!-- Sol: Kaynak Entity (5 Kolon) -->
        <div class="lg:col-span-5 bg-slate-800 border border-slate-700 rounded-2xl p-6 shadow-xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-700 pb-3">
                <span class="text-xs font-bold text-amber-400 uppercase tracking-wider">Kaynak: User (Entity)</span>
                <span class="px-2 py-0.5 text-[10px] bg-amber-500/20 text-amber-300 rounded font-mono">Veritabanı Modeli</span>
            </div>

            <div class="bg-slate-900 p-4 rounded-xl space-y-2 text-xs font-mono text-slate-300 border border-slate-800">
                <p><span class="text-slate-500">Id:</span> @sourceUser?.Id</p>
                <p><span class="text-indigo-400">FirstName:</span> @sourceUser?.FirstName</p>
                <p><span class="text-indigo-400">LastName:</span> @sourceUser?.LastName</p>
                <p><span class="text-sky-400">Email:</span> @sourceUser?.Email</p>
                <div class="pt-2 border-t border-slate-800">
                    <span class="text-rose-400 block font-bold">⚠️ PasswordHash (Gizli Veri):</span>
                    <span class="text-slate-500 text-[10px] break-all">@sourceUser?.PasswordHash</span>
                </div>
            </div>

            <p class="text-[11px] text-slate-400">
                Bu nesne veritabanı tablosunu temsil eder ve hassas şifre hash'i barındırır.
            </p>
        </div>

        <!-- Orta: Dönüşüm Oku (1 Kolon) -->
        <div class="lg:col-span-1 text-center py-2 flex flex-col items-center justify-center">
            <span class="text-2xl text-indigo-400">➔</span>
            <span class="text-[10px] font-mono text-slate-400 mt-1 block">AutoMapper</span>
        </div>

        <!-- Sağ: Hedef DTO (5 Kolon) -->
        <div class="lg:col-span-5 bg-slate-800 border border-emerald-500/40 rounded-2xl p-6 shadow-xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-700 pb-3">
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Hedef: UserDto (DTO)</span>
                <span class="px-2 py-0.5 text-[10px] bg-emerald-500/20 text-emerald-300 rounded font-mono">İstemci Modeli</span>
            </div>

            <div class="bg-slate-900 p-4 rounded-xl space-y-2 text-xs font-mono text-slate-300 border border-slate-800">
                <p><span class="text-slate-500">Id:</span> @Model.Id</p>
                <p><span class="text-emerald-400 font-bold">FullName:</span> @Model.FullName</p>
                <p><span class="text-sky-400">Email:</span> @Model.Email</p>
                <div class="pt-2 border-t border-slate-800">
                    <span class="text-emerald-400 font-bold block">✔ PasswordHash:</span>
                    <span class="text-slate-400 text-[11px]">Filtrelendi (İstemciye asla gitmez!)</span>
                </div>
            </div>

            <p class="text-[11px] text-slate-400">
                FullName alanı <code>UserProfile</code> kuralı ile FirstName ve LastName'den birleştirildi.
            </p>
        </div>

    </div>

    <!-- Eşleme Profili Kod Açıklaması -->
    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 shadow-xl space-y-3">
        <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <span>⚙️</span>
            <span>UserProfile.cs Eşleme Kodu</span>
        </h3>
        <div class="p-4 bg-slate-900 rounded-xl text-xs font-mono text-indigo-300 border border-slate-800">
            CreateMap&lt;User, UserDto&gt;()<br />
            &nbsp;&nbsp;.ForMember(dest =&gt; dest.FullName, opt =&gt; opt.MapFrom(src =&gt; $"{src.FirstName} {src.LastName}"))<br />
            &nbsp;&nbsp;.ReverseMap();
        </div>
    </div>

    <!-- Hızlı Geçiş Bağlantıları -->
    <div class="flex flex-wrap items-center gap-3 pt-2">
        <a asp-action="MappingTest" class="inline-flex items-center gap-2 px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-semibold rounded-xl transition border border-slate-700">
            2. DTO ➔ Entity (ReverseMap) Sayfası →
        </a>
        <a asp-controller="Integration" asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-xl transition shadow-lg shadow-emerald-600/30">
            ⚡ 3. Dış API Entegrasyonu (Gerçek Hayat) →
        </a>
    </div>

</div>
