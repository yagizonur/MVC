<!DOCTYPE html>
<html lang="tr" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Ticaret & Portalı (Genel Kullanıcı Arayüzü)</title>
    <!-- Tailwind CSS 3.x CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-slate-900 text-slate-100 min-h-full flex flex-col font-sans antialiased">

    <header class="bg-slate-800/90 backdrop-blur border-b border-slate-700/80 sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-indigo-400 font-bold text-lg flex items-center gap-2">
                <span>🌐</span>
                <span>Portal Ana Sayfası (Public)</span>
            </a>

            <!-- Admin Area'ya Geçiş Butonu -->
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="inline-flex items-center gap-2 px-3.5 py-2 bg-rose-600 hover:bg-rose-500 text-white rounded-xl text-xs font-semibold transition shadow-md shadow-rose-600/30">
                <span>🔐</span>
                <span>Admin Paneline Giriş Yap</span>
            </a>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-8">
        @RenderBody()
    </main>

    <footer class="bg-slate-950 border-t border-slate-800 py-6 text-center text-xs text-slate-500">
        &copy; @DateTime.Now.Year - ASP.NET Core MVC Area Mimarisi (Genel Site)
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
