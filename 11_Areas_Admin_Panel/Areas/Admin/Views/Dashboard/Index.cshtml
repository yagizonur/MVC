@{
    ViewData["Title"] = "Yönetim Paneli (Dashboard)";
}

<!--
====================================================================
KONU: ASP.NET CORE AREA İÇİNDEKİ VIEW'LERİN ÇALIŞMA PRENSİBİ
====================================================================
1. Klasör Hiyerarşisi:
   - Views klasörü doğrudan Areas/Admin/Views altında bulunur.
   - Bu Area'ya özel _ViewStart.cshtml tanımlanarak Layout = "_AdminLayout"
     varsayılan şablon yapılmıştır.

2. Routing Eşleşmesi:
   - Controller: [Area("Admin")] public class DashboardController
   - URL: /Admin/Dashboard/Index
====================================================================
-->

<div class="space-y-6">

    <!-- Karşılama Başlığı -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-slate-800 pb-4">
        <div>
            <span class="inline-block px-2.5 py-1 text-xs font-semibold bg-rose-500/20 text-rose-300 rounded-full mb-1">
                Admin Area &bull; Dashboard
            </span>
            <h1 class="text-2xl md:text-3xl font-black text-white">Yönetim Paneli Göstergeleri</h1>
            <p class="text-slate-400 text-xs md:text-sm mt-1">İzole edilmiş Area yapısı üzerinden çalışan yönetici ekranı</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="px-3.5 py-2 bg-rose-600 hover:bg-rose-500 text-white rounded-xl text-xs font-semibold transition shadow-lg shadow-rose-600/30">
                📦 Ürün Yönetimine Git
            </a>
        </div>
    </div>

    <!-- 4 İstatistik Kartı -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-2">
            <div class="flex items-center justify-between text-slate-400 text-xs">
                <span>Toplam Ciro</span>
                <span class="p-1.5 bg-emerald-500/10 text-emerald-400 rounded-lg">💰</span>
            </div>
            <div class="text-2xl font-black text-white">@ViewBag.TotalSales</div>
            <span class="text-[10px] text-emerald-400 font-semibold">↑ Geçen aya göre %18 artış</span>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-2">
            <div class="flex items-center justify-between text-slate-400 text-xs">
                <span>Aktif Kullanıcılar</span>
                <span class="p-1.5 bg-indigo-500/10 text-indigo-400 rounded-lg">👥</span>
            </div>
            <div class="text-2xl font-black text-white">@ViewBag.ActiveUsers</div>
            <span class="text-[10px] text-indigo-400 font-semibold">● Şu anda çevrimiçi</span>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-2">
            <div class="flex items-center justify-between text-slate-400 text-xs">
                <span>Bekleyen Siparişler</span>
                <span class="p-1.5 bg-amber-500/10 text-amber-400 rounded-lg">📦</span>
            </div>
            <div class="text-2xl font-black text-white">@ViewBag.TotalOrders</div>
            <span class="text-[10px] text-amber-400 font-semibold">Kargoya verilecek</span>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-2">
            <div class="flex items-center justify-between text-slate-400 text-xs">
                <span>Açık Talepler</span>
                <span class="p-1.5 bg-rose-500/10 text-rose-400 rounded-lg">💬</span>
            </div>
            <div class="text-2xl font-black text-white">@ViewBag.PendingTickets</div>
            <span class="text-[10px] text-rose-400 font-semibold">Yanıt bekliyor</span>
        </div>

    </div>

    <!-- Area Mimarisi Teknik Açıklama Kartı -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
        <h2 class="text-base font-bold text-white flex items-center gap-2">
            <span>⚙️</span>
            <span>Area Mimarisinin Klasör & Rota Yapısı</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">

            <div class="bg-slate-950 p-4 rounded-xl border border-slate-800/80 space-y-2 font-mono text-slate-300">
                <span class="text-indigo-400 font-bold block">Klasör Hiyerarşisi:</span>
                <p>📁 Areas/</p>
                <p class="pl-4">📁 Admin/</p>
                <p class="pl-8">📁 Controllers/ ➔ DashboardController.cs</p>
                <p class="pl-8">📁 Views/</p>
                <p class="pl-12">📁 Dashboard/ ➔ Index.cshtml</p>
                <p class="pl-12">📁 Shared/ ➔ _AdminLayout.cshtml</p>
                <p class="pl-12">📄 _ViewStart.cshtml</p>
            </div>

            <div class="bg-slate-950 p-4 rounded-xl border border-slate-800/80 space-y-2 font-mono text-slate-300">
                <span class="text-emerald-400 font-bold block">Program.cs Rota Kuralı:</span>
                <p class="text-slate-400">app.MapControllerRoute(</p>
                <p class="pl-4 text-amber-300">name: "areas",</p>
                <p class="pl-4 text-emerald-300">pattern: "{area:exists}/{controller=Dashboard}/{action=Index}/{id?}"</p>
                <p class="text-slate-400">);</p>
                <p class="text-[11px] text-slate-500 pt-2 font-sans">
                    <code>{area:exists}</code> ibaresi yalnızca <code>[Area("Admin")]</code> ile işaretlenmiş controller'ların buraya düşmesini sağlar.
                </p>
            </div>

        </div>
    </div>

</div>
