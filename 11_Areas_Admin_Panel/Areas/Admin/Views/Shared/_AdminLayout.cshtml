<!DOCTYPE html>
<html lang="tr" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Yönetim Paneli</title>
    <!-- Tailwind CSS 3.x CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-slate-950 text-slate-100 min-h-full flex font-sans antialiased">

    <!-- Sol Sabit Admin Menüsü (Sidebar) -->
    <aside class="w-64 bg-slate-900 border-r border-slate-800 flex flex-col justify-between p-4 hidden md:flex shrink-0">
        <div class="space-y-6">
            <!-- Admin Logo & Başlık -->
            <div class="flex items-center gap-3 px-2 py-1">
                <span class="p-2 bg-rose-600/20 text-rose-400 rounded-xl text-xl font-bold">⚡</span>
                <div>
                    <span class="text-sm font-extrabold text-white tracking-wide block">YÖNETİM PANELİ</span>
                    <span class="text-[10px] text-rose-400 font-mono tracking-wider font-semibold">AREA: ADMIN</span>
                </div>
            </div>

            <!-- Menü Bağlantıları -->
            <nav class="space-y-1 text-xs font-semibold">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-slate-800 text-white shadow-sm border border-slate-700/60">
                    <span>📊</span>
                    <span>Gösterge Paneli (Dashboard)</span>
                </a>
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/60 transition">
                    <span>📦</span>
                    <span>Ürün Yönetimi</span>
                </a>
                <div class="pt-4 border-t border-slate-800">
                    <span class="px-3 text-[10px] uppercase font-bold text-slate-500 tracking-wider">Site Geçişi</span>
                </div>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-indigo-400 hover:text-indigo-300 hover:bg-indigo-500/10 transition">
                    <span>🌐</span>
                    <span>Ana Siteye Dön (Public)</span>
                </a>
            </nav>
        </div>

        <!-- Yönetici Profil Kartı -->
        <div class="p-3 bg-slate-800/80 rounded-xl border border-slate-700/60 flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center font-bold text-xs">
                OY
            </div>
            <div class="truncate">
                <span class="text-xs font-bold text-white block truncate">Onur Yağız</span>
                <span class="text-[10px] text-slate-400 block">Süper Yönetici</span>
            </div>
        </div>
    </aside>

    <!-- Sağ Ana İçerik Alanı -->
    <div class="flex-1 flex flex-col min-w-0">

        <!-- Üst Bilgi Barı -->
        <header class="bg-slate-900/80 backdrop-blur border-b border-slate-800 h-16 flex items-center justify-between px-6 sticky top-0 z-40">
            <div class="flex items-center gap-2 text-xs">
                <span class="text-slate-500">Admin Area</span>
                <span class="text-slate-600">/</span>
                <span class="text-slate-200 font-semibold">@ViewData["Title"]</span>
            </div>

            <div class="flex items-center gap-3">
                <span class="px-2.5 py-1 text-[11px] bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 rounded-lg font-mono">
                    ● Sistem Durumu: Normal
                </span>
            </div>
        </header>

        <!-- Gövde -->
        <main class="flex-1 p-6 max-w-7xl w-full mx-auto">
            @RenderBody()
        </main>

        <!-- Alt Bilgi -->
        <footer class="bg-slate-900 border-t border-slate-800 py-4 px-6 text-center text-xs text-slate-500">
            &copy; @DateTime.Now.Year - ASP.NET Core MVC Area (Admin Paneli) Mimarisi
        </footer>

    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
