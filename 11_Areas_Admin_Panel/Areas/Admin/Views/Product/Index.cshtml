@{
    ViewData["Title"] = "Ürün Envanter Yönetimi";
}

<!--
====================================================================
KONU: ADMIN AREA İÇİNDEKİ FARKLI CONTROLLER VE ROUTE
====================================================================
Bu sayfa: /Admin/Product/Index
Controller: [Area("Admin")] public class ProductController : Controller
====================================================================
-->

<div class="space-y-6">

    <!-- Başlık -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-slate-800 pb-4">
        <div>
            <span class="inline-block px-2.5 py-1 text-xs font-semibold bg-rose-500/20 text-rose-300 rounded-full mb-1">
                Admin Area &bull; Ürünler
            </span>
            <h1 class="text-2xl md:text-3xl font-black text-white">Ürün Envanter Yönetimi</h1>
            <p class="text-slate-400 text-xs md:text-sm mt-1">Yönetici paneli üzerinden ürün stokları ve fiyat güncelleme işlemleri</p>
        </div>
        <button type="button" class="px-4 py-2 bg-rose-600 hover:bg-rose-500 text-white rounded-xl text-xs font-semibold transition shadow-lg shadow-rose-600/30">
            + Yeni Ürün Ekle
        </button>
    </div>

    <!-- Ürün Tablosu -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
        <div class="p-4 border-b border-slate-800 flex items-center justify-between">
            <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">Kayıtlı Envanter Listesi</span>
            <span class="text-xs text-slate-500 font-mono">Filtrelenen: 4 Kayıt</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-300">
                <thead class="bg-slate-950 text-slate-400 uppercase font-mono">
                    <tr>
                        <th class="p-4">SKU / ID</th>
                        <th class="p-4">Ürün Adı</th>
                        <th class="p-4">Kategori</th>
                        <th class="p-4">Fiyat</th>
                        <th class="p-4">Stok Durumu</th>
                        <th class="p-4 text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800">
                    <tr class="hover:bg-slate-800/40 transition">
                        <td class="p-4 font-mono text-rose-400 font-bold">#PRD-101</td>
                        <td class="p-4 font-medium text-white">Deri Sırt Çantası</td>
                        <td class="p-4 text-slate-400">Aksesuar</td>
                        <td class="p-4 font-mono text-emerald-400 font-bold">₺1.200,00</td>
                        <td class="p-4"><span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300">Stokta (48 Adet)</span></td>
                        <td class="p-4 text-right space-x-2">
                            <button class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-[11px] transition">Düzenle</button>
                            <button class="px-2.5 py-1 bg-rose-600/20 hover:bg-rose-600/30 text-rose-300 rounded-lg text-[11px] transition">Sil</button>
                        </td>
                    </tr>
                    <tr class="hover:bg-slate-800/40 transition">
                        <td class="p-4 font-mono text-rose-400 font-bold">#PRD-102</td>
                        <td class="p-4 font-medium text-white">Kablosuz Kulaklık ANC</td>
                        <td class="p-4 text-slate-400">Elektronik</td>
                        <td class="p-4 font-mono text-emerald-400 font-bold">₺3.500,00</td>
                        <td class="p-4"><span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300">Stokta (112 Adet)</span></td>
                        <td class="p-4 text-right space-x-2">
                            <button class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-[11px] transition">Düzenle</button>
                            <button class="px-2.5 py-1 bg-rose-600/20 hover:bg-rose-600/30 text-rose-300 rounded-lg text-[11px] transition">Sil</button>
                        </td>
                    </tr>
                    <tr class="hover:bg-slate-800/40 transition">
                        <td class="p-4 font-mono text-rose-400 font-bold">#PRD-103</td>
                        <td class="p-4 font-medium text-white">Mekanik Klavye RGB</td>
                        <td class="p-4 text-slate-400">Elektronik</td>
                        <td class="p-4 font-mono text-emerald-400 font-bold">₺2.200,00</td>
                        <td class="p-4"><span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300">Kritik Stok (3 Adet)</span></td>
                        <td class="p-4 text-right space-x-2">
                            <button class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-[11px] transition">Düzenle</button>
                            <button class="px-2.5 py-1 bg-rose-600/20 hover:bg-rose-600/30 text-rose-300 rounded-lg text-[11px] transition">Sil</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

