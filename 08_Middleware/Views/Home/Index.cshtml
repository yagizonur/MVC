@{
    ViewData["Title"] = "HTTP Request Pipeline & Middleware";
}

<!--
====================================================================
KONU: ASP.NET CORE REQUEST PIPELINE & MIDDLEWARE MİMARİSİ
====================================================================
1. Middleware Nedir?
   - HTTP istek ve yanıt hattına (Pipeline) yerleştirilen yazılım bileşenleridir.
   - Her middleware isteği denetleyebilir, değiştirebilir, sonraki adıma aktarabilir
     veya hattı sonlandırabilir (short-circuit).







2. Çalışma Sırası (Russian Doll Modeli):
   - İstek (Request) girerken middleware'ler sırayla çalışır.
   - Yanıt (Response) dönerken tam tersi sırayla geriye doğru akar.
====================================================================
-->

        <div class="space-y-6 max-w-5xl mx-auto">

        <!-- Başlık -->
    <div class="border-b border-slate-800 pb-4">
        <span class="inline-block px-2.5 py-1 text-xs font-semibold bg-indigo-500/20 text-indigo-300 rounded-full mb-2">
    Modül 14: Middleware
    </span>
        <h1 class="text-3xl font-extrabold text-white">HTTP Request Pipeline & Middleware Mimarisi</h1>
            <p class="text-slate-400 text-sm mt-1">İstek işleme boru hattı, özel middleware geliştirme ve yaşam döngüsü yönetimi</p>
            </div>

            <!-- Canlı Test Butonları ve Durum Rozeti -->
        <div class="flex flex-wrap items-center justify-between gap-4 bg-slate-800 border border-slate-700 rounded-2xl p-5 shadow-xl">
        <div>
        <span class="text-xs text-slate-400 block">Şu Anki İstek Türü:</span>
            <span class="text-sm font-bold @(ViewBag.IsDelay ? "text-amber-400" : "text-emerald-400")">
                @(ViewBag.IsDelay ? "⏳ 250ms Kasıtlı Gecikmeli İstek" : "⚡ Standart Hızlı İstek")
            </span>
            </div>

            <div class="flex items-center gap-3">
        <a asp-action="Index" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white text-xs font-semibold rounded-xl transition">
    Normal İstek Test Et
            </a>
    <a asp-action="SimulateDelay" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-xl transition shadow-lg shadow-indigo-600/30">
    Gecikmeli İstek Test Et (250ms) ⏳
        </a>
            </div>
            </div>

    <!-- Görsel Pipeline Akış Şeması -->
        <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 shadow-xl space-y-4">
        <h2 class="text-base font-bold text-white flex items-center gap-2">
            <span>🔄</span>
                <span>HTTP Request - Response Boru Hattı Akış Şeması</span>
                </h2>

        <div class="grid grid-cols-1 md:grid-cols-5 gap-3 text-center text-xs font-mono">

            <div class="bg-slate-900 border border-slate-700 p-4 rounded-xl space-y-1">
            <span class="text-indigo-400 font-bold block">1. İstemci</span>
                <span class="text-[11px] text-slate-400">Tarayıcı İsteği Başlatır</span>
                </div>

            <div class="flex items-center justify-center text-slate-600 font-bold text-lg">➔</div>

            <div class="bg-slate-900 border border-indigo-500/50 p-4 rounded-xl space-y-1 shadow-lg shadow-indigo-500/10">
                <span class="text-indigo-300 font-bold block">2. Custom Middleware</span>
            <span class="text-[10px] text-amber-300">RequestTiming (Kronometre Aç)</span>
                <span class="text-[10px] text-sky-300 block">CustomHeader (Başlık Ekle)</span>
                </div>

            <div class="flex items-center justify-center text-slate-600 font-bold text-lg">➔</div>

        <div class="bg-slate-900 border border-emerald-500/50 p-4 rounded-xl space-y-1 shadow-lg shadow-emerald-500/10">
                <span class="text-emerald-400 font-bold block">3. Action & View</span>
        <span class="text-[11px] text-slate-400">HomeController.Index()</span>
            <span class="text-[10px] text-emerald-300 block">HTML Render Edilir</span>
        </div>

        </div>

    <p class="text-xs text-slate-400 italic text-center pt-2">
            Yanıt istemciye dönerken boru hattından tersine geçer; RequestTimingMiddleware süreyi durdurup yanıt başlığına <code>X-Response-Time-Ms</code> olarak ekler.
        </p>
            </div>

                <!-- Aktif İstek ve Başlık Bilgileri -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 shadow-xl space-y-3">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                <span>📨</span>
            <span>İstek (Request) Bilgileri</span>
        </h3>
            <div class="bg-slate-900 p-4 rounded-xl space-y-2 text-xs font-mono text-slate-300 border border-slate-800">
        <p><span class="text-indigo-400">HTTP Metodu:</span> @ViewBag.RequestMethod</p>
            <p><span class="text-indigo-400">İstek Yolu:</span> @ViewBag.RequestPath</p>
                <p class="truncate"><span class="text-indigo-400">User-Agent:</span> @ViewBag.UserAgent</p>
                </div>
            </div>

                <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 shadow-xl space-y-3">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                <span>🏷️</span>
            <span>Middleware Tarafından Eklenen Başlıklar</span>
        </h3>
            <div class="bg-slate-900 p-4 rounded-xl space-y-2 text-xs font-mono text-slate-300 border border-slate-800">
    <p><span class="text-emerald-400">X-Response-Time-Ms:</span> Hesaplanıp Response Header'a yazıldı</p>
                <p><span class="text-sky-400">X-Powered-By-Course:</span> ASP.NET Core MVC Akademi</p>
    <p><span class="text-amber-400">X-Server-Time:</span> UTC Zaman Damgası</p>
    </div>
        </div>

            </div>

            <!-- Metot Karşılaştırma Kutusu -->
        <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 shadow-xl space-y-3">
    <h3 class="text-sm font-bold text-indigo-400 uppercase tracking-wider">3 Temel Middleware Tanımlama Metodu</h3>
        <ul class="text-xs text-slate-300 space-y-2 leading-relaxed">
<li><strong class="text-sky-400">app.Use():</strong> İsteği işler ve <code>await next()</code> çağrısı ile zincirdeki bir sonraki middleware'e devreder. En esnek ve en yaygın yöntemdir.</li>
            <li><strong class="text-rose-400">app.Run():</strong> Boru hattını sonlandıran terminal middleware'dir. Kendisinden sonraki hiçbir middleware çalıştırılmaz (Short-circuit).</li>
            <li><strong class="text-amber-400">app.Map():</strong> Belirli bir URL yoluna (örneğin <code>/api</code> veya <code>/admin</code>) göre boru hattını dallandırır (Branching).</li>
</ul>
</div>

</div>
