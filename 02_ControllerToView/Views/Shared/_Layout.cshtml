<!DOCTYPE html>
<html lang="tr" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Controller to View & Tailwind</title>
    <!-- Tailwind CSS 3.x CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-full flex flex-col font-sans">

    <header class="bg-slate-800/90 backdrop-blur border-b border-slate-700/80 sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <a asp-controller="Product" asp-action="Index" class="text-indigo-400 font-bold text-lg flex items-center gap-2">
                <span>🛒</span>
                <span>Controller to View Demo</span>
            </a>
            <a asp-controller="Product" asp-action="Details">Idye Göre Ürün</a>
        </div>
    </header>

    <main class="flex-1 max-w-4xl w-full mx-auto px-4 py-8">
        @RenderBody()
    </main>

    <footer class="bg-slate-950 border-t border-slate-800 py-6 text-center text-xs text-slate-500">
        &copy; @DateTime.Now.Year - Modern ASP.NET Core Controller To View
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
