@model ErrorViewModel
@{
    ViewData["Title"] = "Hata Yakalandı";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="bg-slate-800 border border-rose-500/50 rounded-2xl p-8 shadow-2xl space-y-4">
        <div class="flex items-center gap-3">
            <span class="p-3 bg-rose-500/20 text-rose-400 rounded-2xl text-2xl">🛡️</span>
            <div>
                <h1 class="text-2xl font-bold text-white">ExceptionFilter Devreye Girdi!</h1>
                <p class="text-rose-400 text-xs font-semibold">Uygulama çökmedi; hata güvenli bir şekilde yakalandı.</p>
            </div>
        </div>

        <div class="bg-slate-900/90 rounded-xl p-4 border border-slate-800 space-y-2 text-xs font-mono">
            <div>
                <span class="text-slate-500 block">Hata Mesajı (context.Exception.Message):</span>
                <span class="text-rose-300 font-bold">@Model.ErrorMessage</span>
            </div>
            <div>
                <span class="text-slate-500 block">İstek Kimliği (RequestId):</span>
                <span class="text-slate-400">@Model.RequestId</span>
            </div>
            <div>
                <span class="text-slate-500 block">Zaman Damgası:</span>
                <span class="text-slate-400">@Model.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</span>
            </div>
        </div>

        <div class="p-4 bg-slate-900/60 rounded-xl text-xs text-slate-300 leading-relaxed border border-slate-800">
            <span class="text-amber-400 font-bold">ExceptionFilter Notu:</span>
            <code>context.ExceptionHandled = true;</code> komutu çalıştırılarak ASP.NET Core'un standart 500 sarı ekranı engellenmiş ve bu özel tasarım hata görünümü render edilmiştir.
        </div>

        <div class="pt-2">
            <a asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-xl transition shadow-lg shadow-indigo-600/30">
                ← Filtreler Ana Sayfasına Dön
            </a>
        </div>
    </div>
</div>
